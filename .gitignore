# Untrusted vendor blobs and everything derived from them — do not commit.
# Re-create from the Dell download (see README.md) + the tools/ scripts.
firmware/
.DS_Store
**/.DS_Store

# Ghidra-generated listings and build caches
**/*.aeon.asm
**/*.aeon.c
tools/aeon-ghidra/*.zip
**/scaler_symbols.tsv
**/sample.c

# dist/ holds large build outputs (regenerated from the Dell zip + tools/),
# but the hand-written build-record manifests are kept under version control.
dist/**
!dist/
!dist/*/
!dist/*/MANIFEST.txt

firmware/unpacked/scaler/ap_combined_patched.bin
firmware/unpacked/scaler/feature-a-asm.txt

# Python bytecode
__pycache__/
*.pyc
